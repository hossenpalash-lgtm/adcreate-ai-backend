# Required
OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_KEY=

# Optional — AI banner-image generation is disabled (503) until this is set
GEMINI_API_KEY=

# Optional — error monitoring, only enabled if set
SENTRY_DSN=

# Comma-separated list of allowed frontend origins for CORS
# (localhost:3000/5173 are always allowed in addition to these)
ALLOWED_ORIGINS=
