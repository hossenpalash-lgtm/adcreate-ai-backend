# Required
OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_KEY=

# Optional — AI banner-image generation is disabled (503) until this is set
GEMINI_API_KEY=

# Optional — stock photo search is disabled (503) until this is set.
# Free key from https://www.pexels.com/api/
PEXELS_API_KEY=

# Optional — error monitoring, only enabled if set
SENTRY_DSN=

# Comma-separated list of allowed frontend origins for CORS
# (localhost:3000/5173 are always allowed in addition to these)
ALLOWED_ORIGINS=

# Optional — Shopify product-import integration
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Optional — Facebook Page + Instagram direct posting is disabled (503)
# until both are set. Also requires registering {BACKEND_URL}/meta/callback
# as a Valid OAuth Redirect URI in the Meta App's Facebook Login settings.
META_APP_ID=
META_APP_SECRET=

# Stripe subscriptions — test-mode keys from Stripe Dashboard > Developers > API keys
STRIPE_SECRET_KEY=
# Filled in once the webhook endpoint is created (Developers > Webhooks)
STRIPE_WEBHOOK_SECRET=
# Recurring Price IDs for the 3 subscription tiers (Products > Pricing)
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=
